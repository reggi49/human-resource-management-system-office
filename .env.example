# HRMS — Environment Configuration
# Copy this file to .env and fill in real values
# NEVER commit the actual .env file to GitHub!

# ═══════════════════════════════════════════════════════════════════
# Database Configuration
# ═══════════════════════════════════════════════════════════════════
DB_HOST=localhost
DB_USER=root
DB_PASS=
DB_NAME=hrms
DB_PORT=3306

# ═══════════════════════════════════════════════════════════════════
# AI Receipt OCR Configuration
# ═══════════════════════════════════════════════════════════════════
AI_OCR_API_KEY=your_api_key_here
AI_OCR_PROVIDER=nararouter
GEMINI_API_KEY=your_gemini_key_here

# ═══════════════════════════════════════════════════════════════════
# HMAC shared secret between PHP hosting and Python sidecar
# Generate with: python3 -c "import secrets; print(secrets.token_hex(32))"
# MUST be identical on both PHP and Python sides
# ═══════════════════════════════════════════════════════════════════
FACE_SECRET=CHANGE_ME_TO_RANDOM_64_CHAR

# ═══════════════════════════════════════════════════════════════════
# Face Service Sidecar URL
# If PHP hosting and sidecar are on the SAME host:
# ═══════════════════════════════════════════════════════════════════
FACE_SERVICE_URL=http://127.0.0.1:8000
# If on DIFFERENT hosts (replace with actual VPS domain):
# FACE_SERVICE_URL=https://face.yourdomain.com

# ═══════════════════════════════════════════════════════════════════
# Matching thresholds — NILAI AWAL, BELUM DIKALIBRASI
# Run tools/calibrate.py with real data to determine optimal values
# ═══════════════════════════════════════════════════════════════════
FACE_THRESHOLD=0.40
FACE_MIN_MARGIN=0.06

# ═══════════════════════════════════════════════════════════════════
# Matching mode
# 1toN = identification (scan gallery, find match)
# 1to1 = verification (employee enters NIK first, then face verify)
# ═══════════════════════════════════════════════════════════════════
FACE_MODE=1toN

# ═══════════════════════════════════════════════════════════════════
# Photo retention in days (UU PDP No. 27/2022 compliance)
# ═══════════════════════════════════════════════════════════════════
PHOTO_RETENTION_DAYS=90

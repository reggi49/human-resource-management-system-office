[Unit]
Description=HRMS Face Recognition Sidecar (InsightFace buffalo_l)
After=network.target
Wants=network-online.target

[Service]
Type=simple
User=faceservice
Group=faceservice
WorkingDirectory=/opt/hrms-face-service
ExecStart=/opt/hrms-face-service/venv/bin/uvicorn main:app --host 127.0.0.1 --port 8000 --workers 1 --log-level info
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal

# Environment
EnvironmentFile=/opt/hrms-face-service/.env

# Security hardening
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/hrms-face-service/logs
PrivateTmp=true
ProtectKernelTunables=true
ProtectControlGroups=true

# Resource limits
MemoryMax=2G
CPUQuota=200%

[Install]
WantedBy=multi-user.target
